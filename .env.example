# Required: a model id from `cursor-agent models` on this host. No default on purpose.
CURSOR_MODEL=

# Authentication of cursor-agent itself (or run `cursor-agent login` once).
# Keep the real value in your secret store, never in git.
CURSOR_API_KEY=

# CURSOR_BRIDGE_PORT=4310
# CURSOR_BRIDGE_BIND=127.0.0.1
# CURSOR_BRIDGE_HOME=~/.config/cursor-bridge
# CURSOR_BRIDGE_TOKEN_FILE=~/.config/cursor-bridge/token
# CURSOR_BRIDGE_WORKSPACE_ROOT=~/cursor-bridge-ws

# Every run passes --trust, so cursor-agent also obeys each workspace's own
# .cursor/cli.json (permissions), .cursor/hooks.json (commands) and
# .cursor/mcp.json (MCP servers). `config` mode does not hold what a
# repository's own configuration permits: list only trusted directories here,
# never third-party clones. See "Tool approval" in the README.
# CURSOR_BRIDGE_ALLOWED_ROOTS=~/cursor-bridge-ws

# Required for the helm-v2 web interface (this is how the bridge must run,
# otherwise the web chat cannot work: tool and MCP prompts would have nobody
# to answer them). `force` = any command not explicitly denied, for whoever
# can send a message: dedicated OS user or container holding nothing else,
# never a workstation. A warning is printed at every start in this mode.
# CURSOR_BRIDGE_APPROVAL=config
# CURSOR_BRIDGE_SANDBOX=               # leave empty for helm-v2 web | enabled | disabled
# CURSOR_BRIDGE_APPROVE_MCPS=1         # 0 = stop approving MCP servers

# CURSOR_BRIDGE_RUN_TIMEOUT_MS=1800000
# CURSOR_BRIDGE_KILL_GRACE_MS=5000
# CURSOR_BRIDGE_MAX_PROMPT_BYTES=100000   # framing + message + attachments; at most 131071
# CURSOR_BRIDGE_MAX_UPLOAD_BYTES=8388608  # decoded size of one /api/upload file
# CURSOR_BRIDGE_READINESS_TTL_MS=60000
# CURSOR_AGENT_BIN=cursor-agent
